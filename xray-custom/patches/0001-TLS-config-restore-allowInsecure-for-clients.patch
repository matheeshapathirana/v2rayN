--- /dev/null
+++ b/transport/internet/tls/allow_insecure_test.go
@@ -0,0 +1,59 @@
+package tls_test
+
+import (
+	gotls "crypto/tls"
+	"net"
+	"testing"
+
+	"github.com/xtls/xray-core/common"
+	"github.com/xtls/xray-core/common/protocol/tls/cert"
+	"github.com/xtls/xray-core/infra/conf"
+	. "github.com/xtls/xray-core/transport/internet/tls"
+)
+
+// handshakeSelfSigned dials a server presenting a self-signed certificate with clientConfig.
+func handshakeSelfSigned(t *testing.T, clientConfig *Config) error {
+	t.Helper()
+	selfSigned, _ := cert.MustGenerate(nil, cert.CommonName("self-signed.test"), cert.DNSNames("self-signed.test"))
+	serverConfig := &Config{Certificate: []*Certificate{ParseCertificate(selfSigned)}}
+
+	listener, err := gotls.Listen("tcp", "127.0.0.1:0", serverConfig.GetTLSConfig())
+	common.Must(err)
+	defer listener.Close()
+
+	go func() {
+		conn, err := listener.Accept()
+		if err != nil {
+			return
+		}
+		_ = conn.(*gotls.Conn).Handshake()
+		conn.Close()
+	}()
+
+	rawConn, err := net.Dial("tcp", listener.Addr().String())
+	common.Must(err)
+	client := gotls.Client(rawConn, clientConfig.GetTLSConfig())
+	defer client.Close()
+	return client.Handshake()
+}
+
+func TestAllowInsecureAcceptsSelfSigned(t *testing.T) {
+	if err := handshakeSelfSigned(t, &Config{ServerName: "self-signed.test", AllowInsecure: true}); err != nil {
+		t.Fatal("handshake with allowInsecure failed: ", err)
+	}
+}
+
+func TestSecureRejectsSelfSigned(t *testing.T) {
+	if err := handshakeSelfSigned(t, &Config{ServerName: "self-signed.test"}); err == nil {
+		t.Fatal("handshake without allowInsecure accepted a self-signed certificate")
+	}
+}
+
+func TestAllowInsecureJSON(t *testing.T) {
+	c := &conf.TLSConfig{AllowInsecure: true, ServerName: "self-signed.test"}
+	built, err := c.Build()
+	common.Must(err)
+	if !built.(*Config).AllowInsecure {
+		t.Fatal(`"allowInsecure": true was not carried into the TLS config`)
+	}
+}
